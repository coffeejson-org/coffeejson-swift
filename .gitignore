.build/
.swiftpm/
.DS_Store

# Skills managed by skills.sh (npx skills). skills-lock.json and
# scripts/update-skills.sh are committed. The downloaded skill folders
# (.agents/skills) and their agent symlinks (.claude/skills) are derived:
# rebuild them with scripts/update-skills.sh. Blanket-ignored so the managed
# set is never hand-listed. Nothing under .claude/ is committed, authored or
# managed, and `git add -f` is not an exception.
/.agents/
/.claude/skills/*
